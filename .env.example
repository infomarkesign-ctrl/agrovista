# Copy to .env and fill in real values. Never commit .env.

# Hostinger SMTP (OTP emails, order and enquiry emails)
HOSTINGER_SMTP=smtp.hostinger.com
HOSTINGER_PORT=465
HOSTINGER_EMAIL=support@agrovista.shop
HOSTINGER_PASSWORD=

# Fast2SMS (phone OTP)
FAST2SMS_API_KEY=

# Signs login sessions — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
